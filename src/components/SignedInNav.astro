---
interface Props {
  guardUnsavedLeave?: boolean;
  booksHref?: string;
}

const { guardUnsavedLeave = false, booksHref = "/books" } = Astro.props;
const unsavedGuard = guardUnsavedLeave ? "" : undefined;
const linkClass =
  "rounded-lg px-3 py-2 text-sm text-primary transition-colors hover:bg-accent hover:text-primary-hover";
---

<nav class="border-border bg-card mb-6 flex flex-wrap items-center gap-2 rounded-xl border p-3 shadow-sm">
  <a href="/" data-unsaved-guard={unsavedGuard} class:list={[linkClass]}>Home</a>
  <a href={booksHref} data-unsaved-guard={unsavedGuard} class:list={[linkClass]}>View your TBR</a>
  <a href="/books/new" data-unsaved-guard={unsavedGuard} class:list={[linkClass]}>Add a book</a>
  <a href="/mood" data-unsaved-guard={unsavedGuard} class:list={[linkClass]}>Pick by mood</a>
  <a href="/account" data-unsaved-guard={unsavedGuard} class:list={[linkClass]}>Account</a>
  <form method="POST" action="/api/auth/signout" data-unsaved-guard={unsavedGuard}>
    <button type="submit" class:list={[linkClass]}>Sign out</button>
  </form>
</nav>
