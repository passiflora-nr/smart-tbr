---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
---

<div class:list={["banner", `banner--${variant}`]} role={variant === "error" ? "alert" : "status"}>
  <slot />
</div>

<style>
  .banner {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    text-align: center;
    border-bottom: 1px solid;
  }
  .banner :global(a) {
    color: inherit;
    text-decoration: underline;
    font-weight: 600;
  }
  .banner--info {
    background: #e9e1d4;
    color: #3d2e2a;
    border-color: #e5ddd3;
  }
  .banner--warning {
    background: #f0d4d8;
    color: #3d2e2a;
    border-color: #e8c4c8;
  }
  .banner--error {
    background: #fdfbf8;
    color: #3d2e2a;
    border-color: #dc2626;
  }
</style>
