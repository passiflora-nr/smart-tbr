---
interface Props {
  id: string;
  title: string;
  size?: "row" | "form";
}

const { id, title, size = "row" } = Astro.props;
const modalId = `delete-${id}`;

const sizeClass = size === "form" ? "inline-flex shrink-0 items-center justify-center px-4 py-2" : "px-3 py-1.5";
---

<a
  href={`#${modalId}`}
  aria-label={`Delete ${title}`}
  class:list={[
    "rounded-lg border border-red-800 bg-red-800 text-sm text-white transition-colors hover:bg-red-900",
    sizeClass,
  ]}
>
  Delete
</a>
