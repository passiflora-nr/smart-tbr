---
import BookDescription from "@/components/books/BookDescription.astro";
import DeleteBookTrigger from "@/components/books/DeleteBookTrigger.astro";
import { buildEditHref } from "@/lib/book-filters";
import type { Tables } from "@/lib/database.types";

interface Props {
  books: Pick<Tables<"books">, "id" | "title" | "author" | "tropes" | "description">[];
  filterQuery: string;
}

const { books, filterQuery } = Astro.props;
---

<ul class="space-y-4">
  {
    books.map((book) => (
      <li id={`book-${book.id}`} class="book-row rounded-lg border border-white/10 bg-white/5 p-4">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0 flex-1">
            <p class="truncate font-medium text-white">{book.title}</p>
            <p class="text-sm text-blue-100/70">{book.author}</p>
          </div>
          <div class="flex shrink-0 flex-wrap items-start justify-end gap-2">
            <a
              href={buildEditHref(book.id, filterQuery)}
              aria-label={`Edit ${book.title}`}
              class="rounded-lg border border-white/20 bg-white/10 px-3 py-1.5 text-sm transition-colors hover:bg-white/20"
            >
              Edit
            </a>
            <DeleteBookTrigger id={book.id} title={book.title} />
          </div>
        </div>
        <BookDescription description={book.description} />
        <ul class="mt-2 flex flex-wrap gap-1.5">
          {book.tropes.map((trope) => (
            <li class="rounded-md bg-white/15 px-2 py-0.5 text-xs text-white">{trope}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ul>
