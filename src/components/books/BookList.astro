---
import BookDescription from "@/components/books/BookDescription.astro";
import DeleteBookTrigger from "@/components/books/DeleteBookTrigger.astro";
import { buildEditHref } from "@/lib/book-filters";
import type { Tables } from "@/lib/database.types";

interface Props {
  books: Pick<Tables<"books">, "id" | "title" | "author" | "tropes" | "description">[];
  filterQuery: string;
}

const { books, filterQuery } = Astro.props;

const tropePillClasses = ["bg-trope-blush", "bg-trope-oat", "bg-trope-stone"] as const;
---

<ul class="space-y-4">
  {
    books.map((book) => (
      <li id={`book-${book.id}`} class="book-row border-border bg-card rounded-lg border p-4 shadow-sm">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0 flex-1">
            <p class="text-foreground font-medium break-words">{book.title}</p>
            <p class="text-muted-foreground text-sm">{book.author}</p>
          </div>
          <div class="flex shrink-0 flex-wrap items-start justify-end gap-2">
            <a
              href={buildEditHref(book.id, filterQuery)}
              aria-label={`Edit ${book.title}`}
              class="border-border bg-card text-foreground hover:bg-background rounded-lg border px-3 py-1.5 text-sm transition-colors"
            >
              Edit
            </a>
            <DeleteBookTrigger id={book.id} title={book.title} />
          </div>
        </div>
        <BookDescription description={book.description} />
        <ul class="mt-2 flex flex-wrap gap-1.5">
          {book.tropes.map((trope, index) => (
            <li class:list={["text-trope-text rounded-md px-2 py-0.5 text-xs", tropePillClasses[index % 3]]}>
              {trope}
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ul>
