---
import type { BookFilters } from "@/lib/book-filters";

interface Props {
  id: string;
  title: string;
  genericConfirm?: boolean;
  editDeleteControls?: boolean;
  /**
   * Where Cancel and the backdrop navigate to dismiss the modal. Point it at a
   * real element near the trigger: the panel is `display: none` the moment the
   * fragment changes, so focus falls back to the document and a keyboard user
   * would otherwise restart tabbing from the top of the page.
   */
  dismissHref: string;
  filters: BookFilters;
}

const { id, title, genericConfirm = false, editDeleteControls = false, dismissHref, filters } = Astro.props;
const modalId = `delete-${id}`;

// role="dialog" carries no aria-modal: this is a CSS-only modal, so nothing can
// make the rest of the page inert, and claiming otherwise misleads assistive tech.
---

<div
  id={modalId}
  class="delete-modal"
  role="dialog"
  aria-labelledby={`${modalId}-heading`}
  {...editDeleteControls ? { "data-edit-delete-controls": true } : {}}
>
  <a href={dismissHref} class="delete-modal-backdrop" aria-label="Cancel deletion">
    <span class="sr-only">Cancel deletion</span>
  </a>
  <div class="delete-modal-panel">
    <h2 id={`${modalId}-heading`} class="text-lg font-semibold text-white">Delete book?</h2>
    {
      genericConfirm ? (
        <p class="mt-2 text-sm text-red-200">Permanently delete this book?</p>
      ) : (
        <p class="mt-2 text-sm text-red-200">
          Permanently delete <span class="font-medium break-words text-red-100">{title}</span>?
        </p>
      )
    }
    <p class="mt-1 text-sm text-red-200">This cannot be undone.</p>
    <div class="mt-4 flex flex-wrap justify-end gap-2">
      <a
        href={dismissHref}
        class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20"
      >
        Cancel
      </a>
      <form method="POST" action={`/api/books/${id}/delete`}>
        {filters.q.length > 0 ? <input type="hidden" name="q" value={filters.q} /> : null}
        {filters.tropes.map((trope) => <input type="hidden" name="trope" value={trope} />)}
        <button
          type="submit"
          aria-label={`Permanently delete ${title}`}
          class="rounded-lg border border-red-500/40 bg-red-900/40 px-4 py-2 text-sm text-red-100 transition-colors hover:bg-red-900/60"
        >
          Delete permanently
        </button>
      </form>
    </div>
  </div>
</div>
