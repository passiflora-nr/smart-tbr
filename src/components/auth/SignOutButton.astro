---
/** Sign-out control shared across authenticated TBR pages. */

interface Props {
  guardUnsavedLeave?: boolean;
}

const { guardUnsavedLeave = false } = Astro.props;
---

<form method="POST" action="/api/auth/signout" data-unsaved-guard={guardUnsavedLeave ? "" : undefined}>
  <button
    type="submit"
    class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
  >
    Sign out
  </button>
</form>
