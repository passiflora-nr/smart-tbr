---
/** Sign-out control shared across authenticated TBR pages. */

interface Props {
  guardUnsavedLeave?: boolean;
}

const { guardUnsavedLeave = false } = Astro.props;
---

<form method="POST" action="/api/auth/signout" class="inline" data-unsaved-guard={guardUnsavedLeave ? "" : undefined}>
  <button
    type="submit"
    class="text-primary hover:bg-accent hover:text-primary-hover rounded-lg px-2.5 py-2 text-sm transition-colors"
  >
    Sign out
  </button>
</form>
