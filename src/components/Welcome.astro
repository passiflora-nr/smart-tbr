---
import SignedInNav from "@/components/SignedInNav.astro";

interface Props {
  notice: string | null;
}

const { notice } = Astro.props;
const user = Astro.locals.user;

const heroPrimaryClass =
  "inline-flex items-center justify-center rounded-lg bg-primary px-6 py-3 text-base font-medium text-primary-foreground transition-colors hover:bg-primary-hover";
const heroSecondaryClass =
  "inline-flex items-center justify-center rounded-lg border border-border bg-card px-6 py-3 text-base font-medium text-foreground transition-colors hover:bg-background";
const featureCardClass = "border-border bg-card rounded-xl border p-6 shadow-sm";
---

<div class="bg-background flex min-h-dvh w-full flex-col">
  <div class="relative mx-auto flex min-h-dvh w-full max-w-4xl flex-col px-4 py-6 sm:px-8">
    {
      user ? (
        <div class="absolute inset-x-4 top-6 z-10 sm:inset-x-8">
          <SignedInNav />
        </div>
      ) : null
    }

    {
      user ? (
        <div class="flex flex-1 flex-col items-center justify-center px-4 text-center">
          {notice ? (
            <p class="border-border bg-accent/50 text-foreground mb-6 w-full max-w-2xl rounded-lg border px-3 py-2 text-center text-sm">
              {notice}
            </p>
          ) : null}
          <h1 class="mb-4 text-5xl leading-tight font-bold sm:text-6xl">SmartTBR</h1>
          <p class="text-muted-foreground mb-8 max-w-2xl text-lg sm:text-xl">
            Your private, trope-indexed To Be Read pile.
            <br />
            Pick your next romance read by mood, not by scrolling forever.
          </p>
          <div class="flex flex-col gap-4 sm:flex-row">
            <a href="/mood" class:list={[heroPrimaryClass]}>
              Pick by mood
            </a>
            <a href="/books" class:list={[heroSecondaryClass]}>
              View your TBR
            </a>
            <a href="/books/new" class:list={[heroSecondaryClass]}>
              Add a book
            </a>
          </div>
        </div>
      ) : (
        <div class="flex flex-1 flex-col items-center justify-center">
          <div class="flex flex-col items-center px-4 text-center">
            {notice ? (
              <p class="border-border bg-accent/50 text-foreground mb-6 w-full max-w-2xl rounded-lg border px-3 py-2 text-center text-sm">
                {notice}
              </p>
            ) : null}
            <h1 class="mb-4 text-4xl leading-tight font-bold sm:text-5xl">SmartTBR</h1>
            <p class="text-muted-foreground mb-6 max-w-2xl text-base sm:text-lg">
              Your private, trope-indexed To Be Read pile.
              <br />
              Pick your next romance read by mood, not by scrolling forever.
            </p>
            <div class="mb-12 flex flex-col gap-4 sm:mb-14 sm:flex-row">
              <a href="/auth/signin" class:list={[heroPrimaryClass]}>
                Sign In
              </a>
              <a href="/auth/signup" class:list={[heroSecondaryClass]}>
                Sign Up
              </a>
            </div>
          </div>

          <div class="grid w-full grid-cols-1 gap-6 px-4 sm:grid-cols-3">
            <div class:list={[featureCardClass]}>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-primary mb-4"
              >
                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
              </svg>
              <h3 class="mb-2 text-lg font-semibold">Your tropes, your pile</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">
                Tag books with the romance tropes you actually use — enemies to lovers, slow burn, found family, and
                whatever else you care about.
              </p>
            </div>

            <div class:list={[featureCardClass]}>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-primary mb-4"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
              </svg>
              <h3 class="mb-2 text-lg font-semibold">Private by default</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">
                Your TBR is yours alone — no public profiles, no shared lists, no social graph.
              </p>
            </div>

            <div class:list={[featureCardClass]}>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-primary mb-4"
              >
                <circle cx="12" cy="12" r="10" />
                <path d="M12 16v-4" />
                <path d="M12 8h.01" />
              </svg>
              <h3 class="mb-2 text-lg font-semibold">Pick by mood</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">
                Choose 1–3 tropes you&apos;re in the mood for and get matching books from your own backlog — no AI, no
                global vocabulary.
              </p>
            </div>
          </div>
        </div>
      )
    }
  </div>
</div>
