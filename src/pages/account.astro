---
import Layout from "@/layouts/Layout.astro";
import DeleteAccountModal from "@/components/account/DeleteAccountModal.astro";
import SignedInNav from "@/components/SignedInNav.astro";

const REDIRECT_ERRORS: Record<string, string> = {
  confirm_mismatch: "Type the exact confirmation word to delete your account.",
  delete_failed: "Could not delete your account. Try again.",
};

const FLASH_ERROR_COOKIE = "account_flash_error";

// Errors the user can correct in the dialog reopen it and show the message inside
// the panel; anything else renders as a page banner, which the modal backdrop
// would otherwise dim to the point of being unreadable.
const DIALOG_ERRORS = new Set(["confirm_mismatch"]);

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const errorParam = Astro.url.searchParams.get("error");

if (errorParam && Object.hasOwn(REDIRECT_ERRORS, errorParam)) {
  Astro.cookies.set(FLASH_ERROR_COOKIE, errorParam, {
    path: "/account",
    maxAge: 30,
    sameSite: "lax",
    httpOnly: true,
  });
  return Astro.redirect(DIALOG_ERRORS.has(errorParam) ? "/account#delete-account" : "/account");
}

const flashErrorCode = Astro.cookies.get(FLASH_ERROR_COOKIE)?.value;

if (flashErrorCode) {
  Astro.cookies.delete(FLASH_ERROR_COOKIE, { path: "/account" });
}

const redirectError =
  flashErrorCode && Object.hasOwn(REDIRECT_ERRORS, flashErrorCode) ? REDIRECT_ERRORS[flashErrorCode] : null;

const dialogError = flashErrorCode && DIALOG_ERRORS.has(flashErrorCode) ? redirectError : null;
const pageError = dialogError ? null : redirectError;
---

<Layout title="Account">
  <div class="bg-background flex min-h-screen items-start justify-center p-4 pt-12">
    <div class="border-border bg-card text-foreground w-full max-w-4xl rounded-2xl border p-8 shadow-sm">
      {
        pageError ? (
          <p class="mb-4 flex w-full items-center justify-center gap-2 rounded-lg border border-red-300 bg-red-50 px-3 py-2 text-center text-sm text-red-800">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4 shrink-0"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <line x1="12" x2="12" y1="8" y2="12" />
              <line x1="12" x2="12.01" y1="16" y2="16" />
            </svg>
            {pageError}
          </p>
        ) : null
      }

      <SignedInNav />
      <h1 class="mb-6 text-2xl font-bold">Account</h1>

      <p class="text-muted-foreground mb-8">
        Signed in as <span class="text-foreground font-medium">{user.email}</span>
      </p>

      <section class="border-border border-t pt-6" aria-labelledby="danger-zone-heading">
        <h2 id="danger-zone-heading" class="text-lg font-semibold">Danger zone</h2>
        <p class="text-muted-foreground mt-2 text-sm">
          Permanently delete your account and every book you have saved. This cannot be undone.
        </p>
        <a
          id="delete-account-trigger"
          href="#delete-account"
          class="mt-4 inline-block rounded-lg border border-red-700 bg-red-700 px-4 py-2 text-sm text-white transition-colors outline-none hover:bg-red-800 focus-visible:ring-2 focus-visible:ring-red-400/60"
        >
          Delete account
        </a>
      </section>
    </div>
    <DeleteAccountModal dismissHref="#delete-account-trigger" error={dialogError} />
  </div>
</Layout>
