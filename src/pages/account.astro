---
import Layout from "@/layouts/Layout.astro";
import SignOutButton from "@/components/auth/SignOutButton.astro";

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect("/auth/signin");
}
---

<Layout title="Account">
  <div class="bg-cosmic flex min-h-screen items-start justify-center p-4 pt-12">
    <div class="w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <div class="mb-6 flex flex-col gap-4">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Account
        </h1>
        <div class="flex flex-wrap gap-2">
          <a
            href="/books"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            View your TBR
          </a>
          <a
            href="/mood"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            Pick by mood
          </a>
          <a
            href="/"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            Home
          </a>
          <SignOutButton />
        </div>
      </div>

      <p class="mb-8 text-blue-100/80">
        Signed in as <span class="font-medium text-white">{user.email}</span>
      </p>

      <section class="border-t border-white/10 pt-6" aria-label="Danger zone">
        <!-- Delete control lands in Phase 3 -->
      </section>
    </div>
  </div>
</Layout>
