---
import Welcome from "@/components/Welcome.astro";
import Layout from "@/layouts/Layout.astro";

const FLASH_NOTICE_COOKIE = "home_flash_notice";
const FLASH_NOTICE_MESSAGES: Record<string, string> = {
  account_deleted: "Your account and all your books have been deleted.",
  account_delete_unknown: "We couldn't verify whether your account was deleted. Try signing in to check.",
};

const flashNoticeCode = Astro.cookies.get(FLASH_NOTICE_COOKIE)?.value;

if (flashNoticeCode) {
  Astro.cookies.delete(FLASH_NOTICE_COOKIE, { path: "/" });
}

const notice =
  flashNoticeCode && Object.hasOwn(FLASH_NOTICE_MESSAGES, flashNoticeCode)
    ? FLASH_NOTICE_MESSAGES[flashNoticeCode]
    : null;
---

<Layout title="Home">
  <Welcome notice={notice} />
</Layout>
