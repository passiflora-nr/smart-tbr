---
import Layout from "@/layouts/Layout.astro";
import DeleteBookModal from "@/components/books/DeleteBookModal.astro";
import DeleteBookTrigger from "@/components/books/DeleteBookTrigger.astro";
import EditBookForm from "@/components/books/EditBookForm";
import SignedInNav from "@/components/SignedInNav.astro";
import { bookIdSchema } from "@/lib/book-schema";
import { buildBooksHref, parseBookFilters, serializeBookFilters } from "@/lib/book-filters";
import { createClient } from "@/lib/supabase";

// data-unsaved-guard and data-edit-delete-controls below are read by
// EditBookForm's document listeners; see the attribute contract table in
// context/changes/edit-delete-book/plan.md (Phase 2, change #5).

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const filters = parseBookFilters(Astro.url.searchParams);
const filterQuery = serializeBookFilters(filters);

const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!supabase) {
  return Astro.redirect(buildBooksHref(filterQuery, { error: "load_failed" }));
}

const idResult = bookIdSchema.safeParse(Astro.params.id);

if (!idResult.success) {
  return Astro.redirect(buildBooksHref(filterQuery, { error: "not_found" }));
}

const id = idResult.data;

const { data: book, error } = await supabase
  .from("books")
  .select("id, title, author, tropes, description")
  .eq("id", id)
  .eq("user_id", user.id)
  .maybeSingle();

if (error) {
  console.error("book edit load failed", error);
  return Astro.redirect(buildBooksHref(filterQuery, { error: "load_failed" }));
}

if (!book) {
  return Astro.redirect(buildBooksHref(filterQuery, { error: "not_found" }));
}
---

<Layout title={`Edit ${book.title}`}>
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-card text-foreground w-full max-w-4xl rounded-2xl border p-8 shadow-sm">
      <SignedInNav guardUnsavedLeave booksHref={buildBooksHref(filterQuery)} />
      <p class="text-muted-foreground mb-1 font-sans text-sm font-medium">Edit</p>
      <h1 class="mb-6 min-w-0 truncate text-2xl font-bold">{book.title}</h1>
      <EditBookForm
        client:load
        id={book.id}
        title={book.title}
        author={book.author}
        tropes={book.tropes}
        description={book.description}
        filterQuery={filterQuery}
      />
      <div id={`delete-controls-${book.id}`} data-edit-delete-controls class="border-border mt-8 border-t pt-6">
        <p class="text-muted-foreground mb-3 text-sm">Remove this book from your TBR permanently.</p>
        <DeleteBookTrigger id={book.id} title={book.title} size="form" />
      </div>
    </div>
    <DeleteBookModal
      id={book.id}
      title={book.title}
      genericConfirm
      editDeleteControls
      dismissHref={`#delete-controls-${book.id}`}
      filters={filters}
    />
  </div>
</Layout>
